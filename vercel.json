{
  "rewrites": [
    { "source": "/api/admin/companies", "destination": "/api/admin" },
    { "source": "/api/reports", "destination": "/api/analytics" },
    { "source": "/api/reports/:path*", "destination": "/api/analytics" },
    { "source": "/api/stats", "destination": "/api/analytics" },
    { "source": "/api/stats/:path*", "destination": "/api/analytics" },
    { "source": "/api/webhook/whatsapp", "destination": "/api/webhook?provider=whatsapp" },
    { "source": "/api/webhook/wompi",    "destination": "/api/webhook?provider=wompi" },
    { "source": "/api/webhook/kommo",    "destination": "/api/webhook?provider=kommo" },
    { "source": "/api/webhook/sms",      "destination": "/api/webhook?provider=sms" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ],
  "functions": {
    "api/**/*.js": {
      "maxDuration": 30
    }
  },
  "crons": [
    {
      "path": "/api/gmail?action=watch",
      "schedule": "0 9 * * *"
    },
    {
      "path": "/api/gmail?action=bank-health",
      "schedule": "0 12 * * *"
    },
    {
      "path": "/api/subscription?action=cron-reminders",
      "schedule": "0 15 * * *"
    },
    {
      "path": "/api/verifications?action=expire-pending",
      "schedule": "0 8 * * *"
    },
    {
      "path": "/api/cron?action=scheduled-notifications",
      "schedule": "0 * * * *"
    }
  ]
}
